# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Packaging / build artifacts
build/
dist/
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# MetaGLens runtime output: generated config and pipeline results are
# per-run artifacts, not source. Keep them out of version control.
metaglens.yaml
metaglens_results/

# Editor / OS noise
.vscode/
.idea/
.qoder/
*.swp
.DS_Store

# 本地预览产物(非源码)
preview/

